            "value" : "btn btn-success"
        },
        {
            "label" : "@@dbuilder.btn.danger@@",
            "value" : "btn btn-danger"
        },
        {
            "label" : "@@dbuilder.btn.warning@@",
            "value" : "btn btn-warning"
        },
        {
            "label" : "@@dbuilder.btn.info@@",
            "value" : "btn btn-info"
        },
        {
            "label" : "@@dbuilder.btn.light@@",
            "value" : "btn btn-light"
